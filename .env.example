PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

MAX_IMAGE_BYTES=20971520
MAX_VIDEO_BYTES=104857600
MAX_DIMENSION=5000
FETCH_TIMEOUT_MS=10000

CACHE_MAX_ENTRIES=500
CACHE_MAX_BYTES=104857600
CACHE_TTL_SECONDS=3600

# Defaults to the number of CPU cores
MAX_CONCURRENT_JOBS=
MAX_QUEUED_JOBS=100

# When set, every request must carry an HMAC signature (at least 16 characters)
SIGNING_SECRET=
# Comma-separated hosts that may be fetched, e.g. images.example.com,*.cdn.example.com
ALLOWED_SOURCE_HOSTS=

# Local development only: allows fetching from localhost and private networks
ALLOW_PRIVATE_NETWORKS=false

# Requests per window per client; 0 disables rate limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
# name:key[:limit] entries, comma-separated; keys are sent as X-API-Key or ?api_key=
API_KEYS=
REQUIRE_API_KEY=false
# Only behind a reverse proxy: take the client IP from X-Forwarded-For
TRUST_PROXY=false
# Shares rate limits across instances; unset keeps counters in memory
REDIS_URL=
