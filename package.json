{
  "name": "image-processing-service",
  "version": "0.1.0",
  "description": "Cloudinary-style on-the-fly image transformation and video thumbnail API",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./sdk/signer": {
      "types": "./dist/sdk/signer.d.ts",
      "default": "./dist/sdk/signer.js"
    }
  },
  "files": [
    "dist",
    "openapi.yaml"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.12.5",
    "ffmpeg-static": "^5.3.0",
    "ioredis": "^6.0.0",
    "sharp": "^0.35.5",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true
  }
}
